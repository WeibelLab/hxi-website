# Netlify redirects
# Generated from each page's `aliases:` front matter by layouts/index.redirects.

{{/* `301!` forces the redirect. Hugo also writes a meta-refresh stub page at
     every alias path, so that old URLs resolve under `hugo server` where this
     file is never read. On Netlify a static file shadows an unforced rule, and
     the stub would win; the `!` keeps the 301. */ -}}
# Rewrites that have no page to live in. These are duplicated from netlify.toml
# on purpose: netlify.toml is only read when Netlify runs the build itself, so a
# manual deploy of a locally built site would otherwise drop them. Netlify
# processes this file top to bottom, and netlify.toml rules still take
# precedence on a git build, so the duplication is harmless.
/weibel /people/nadir-weibel/ 200!
/weibel/cv /people/nadir-weibel/CV_NadirWeibel.pdf 200!
/join https://forms.gle/w7WswQadg2s79wbU8 200!
# Person pages moved from /author/ to /people/ on 2026-09-25. One wildcard
# covers all of them, including anyone added later; per-person aliases would
# need maintaining forever.
/author/* /people/:splat 301!
# 301, not the 200 proxy netlify.toml used: a proxied fetch of the Netlify
# dashboard carries no login session and returns 500. A redirect opens it in
# the browser, signed in.
/deploy https://app.netlify.com/sites/hxi-ucsd/deploys 301!
/course/cse218/enroll https://forms.gle/eGcyWzXZqX2AmZRA6 200!

{{- range .Site.Pages -}}
{{- $target := .RelPermalink -}}
{{- range .Aliases }}
{{ . | relLangURL }} {{ $target }} 301!
{{- end -}}
{{- end }}
